# gmail account that sends and receives the messages (use an app password, not your account password)
GMAIL_EMAIL=you@gmail.com
GMAIL_PASSWORD=your-16-character-app-password

# shared secret callers send as "Authorization: Bearer <key>". at least 32 random characters.
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILJS_API_KEY=

PORT=8080
